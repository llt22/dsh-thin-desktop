{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSH Thin Desktop",
  "version": "0.2.2",
  "identifier": "com.dsh.thin-desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self'; script-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "DSH Thin Desktop",
        "url": "index.html",
        "width": 1180,
        "height": 780,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
